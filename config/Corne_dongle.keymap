/*
 * Imported from keyboards/crkbd/keymaps/jimx in qmk_firmware.
 * Source keymap/config are GPL-2.0-or-later.
 * SPDX-License-Identifier: GPL-2.0-or-later
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

#define QWERTY 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

// PERMISSIVE_HOLD: resolve nested key taps as holds.
// TAPPING_FORCE_HOLD: a repeated tap can become a hold.
&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <0>;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    macros {
        // QMK RGBRST: enable RGB, solid red, full saturation, capped brightness.
        rgb_reset: rgb_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap>,
                       <&rgb_ug RGB_ON>,
                       <&rgb_ug RGB_EFS_CMD 0>,
                       <&rgb_ug RGB_COLOR_HSB_CMD RGB_COLOR_HSB_VAL(0, 100, 47)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            display-name = "QWERTY";
            bindings = <
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSLH
                &kp ESC  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT
                &kp LGUI  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp SPACE
                &mo LOWER  &mt LCTRL SPACE  &kp LSHFT  &kp BSPC  &mt LALT RET  &mo RAISE
            >;
        };

        lower_layer {
            display-name = "LOWER";
            bindings = <
                &kp GRAVE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp ASTERISK  &kp LPAR  &kp RPAR  &none
                &kp TILDE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &none
                &kp F11  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
                &mo LOWER  &mt LCTRL SPACE  &kp LSHFT  &kp BSPC  &mt LALT RET  &mo RAISE
            >;
        };

        raise_layer {
            display-name = "RAISE";
            bindings = <
                &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &none  &kp MINUS  &kp UNDER  &none  &none  &kp PLUS  &kp EQUAL  &kp INS  &kp HOME  &kp PG_UP
                &kp LCTRL  &none  &none  &none  &none  &none  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none  &none
                &kp LSHFT  &none  &none  &kp LBKT  &kp LBRC  &none  &none  &kp RBRC  &kp RBKT  &kp DEL  &kp END  &kp PG_DN
                &mo LOWER  &mt LCTRL SPACE  &kp LSHFT  &kp BSPC  &mt LALT RET  &mo RAISE
            >;
        };

        // Adjust: Y/U/I/O/P select Bluetooth profiles 1–5; backslash clears the selected profile.
        adjust_layer {
            display-name = "ADJUST";
            bindings = <
                &bootloader  &rgb_reset  &none  &none  &none  &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
                &rgb_ug RGB_TOG  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &none  &none  &none  &none  &none  &none  &none  &none
                &rgb_ug RGB_EFF  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &none  &none  &none  &none  &none  &none  &none  &none
                &kp LGUI  &mo LOWER  &kp SPACE  &kp RET  &mo RAISE  &kp RALT
            >;
        };

        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
        extra3 { status = "reserved"; };
        extra4 { status = "reserved"; };
    };
};
